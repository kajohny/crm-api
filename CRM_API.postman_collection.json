{
  "info": {
    "_postman_id": "a787d8bb-a20a-4b9c-a1c8-ce7821cdd458",
    "name": "CRM API — Laravel PostgreSQL",
    "description": "Примеры запросов к тестовой CRM. Запустите сверху вниз после docker compose up --build. Два менеджера создаются сидером автоматически. Даты встреч указаны в UTC, локальное время Алматы — UTC+5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Создать компанию 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/companies",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Company 1\",\n  \"bin\": \"{{binOne}}\",\n  \"phone\": \"+77000000001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('binOne', '1' + String(Math.floor(Math.random() * 1e11)).padStart(11, '0'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('companyOneId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
